# ============================================================================
# BFMC Brain — Environment Configuration
# ============================================================================
# Edit this file BEFORE launching: python main.py
#
# All variables are read at startup by src/utils/config.py.
# Import anywhere:  from src.utils.config import cfg
# Usage:            cfg.USE_LIVE_CAMERA, cfg.VIDEO_PATH, etc.
#
# Boolean values: True / False  (case-insensitive)
# List values:    comma-separated, e.g.  87,90,303,135
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# CAMERA & VIDEO INPUT
# ──────────────────────────────────────────────────────────────────────────────

# Use the live USB camera feed (True) or play back a recorded video file (False).
# When False, the file at VIDEO_PATH is used instead.
BFMC_USE_LIVE_CAMERA=False

# Path (relative to Brain/) of the video file to play when USE_LIVE_CAMERA=False.
# BFMC_VIDEO_PATH=raw_data/qualification_video.mp4
BFMC_VIDEO_PATH=raw_data/bfmc2020_online_2.mp4

# Whether to loop the video file when it reaches the end.
# Only relevant when USE_LIVE_CAMERA=False.
BFMC_LOOP_VIDEO=True

# Target FPS for the camera / video-feed thread.
# 0 = max speed (no throttle). For live camera, hardware is the bottleneck.
BFMC_CAMERA_FPS=0

# Camera model identifier used by LaneKeeping / LaneDetection to choose
# the correct region-of-interest and calibration parameters.
# Supported values: "455" (Intel RealSense D455) or "405" (Intel RealSense D405).
BFMC_CAMERA_TYPE=455

# Main (full-resolution) capture size. Used for recording and on-board processing.
BFMC_CAMERA_MAIN_WIDTH=2048
BFMC_CAMERA_MAIN_HEIGHT=1080

# Low-resolution stream size sent to the dashboard for live preview.
BFMC_CAMERA_LORES_WIDTH=512
BFMC_CAMERA_LORES_HEIGHT=270

# Camera brightness (0.0 – 1.0) and contrast applied to the camera stream.
BFMC_CAMERA_BRIGHTNESS=0.5
BFMC_CAMERA_CONTRAST=16.0


# ──────────────────────────────────────────────────────────────────────────────
# TRAFFIC-SIGN DETECTION (YOLO)
# ──────────────────────────────────────────────────────────────────────────────

# Path to the YOLOv8 / YOLO-NAS weights file for traffic-sign detection.
# Relative to Brain/ root. Accepts .pt or .onnx.
BFMC_TSD_WEIGHTS=traffic-sign-detection-model/traffic-sign-yolo26n-bfmc.pt

# Minimum confidence score [0.0 – 1.0] for a YOLO detection to be accepted.
# Lower = more detections (but more false positives); higher = fewer but more certain.
BFMC_TSD_CONFIDENCE=0.25

# Inference image size (pixels). Must match the size the model was trained on.
# Common values: 320, 640, 1280. Larger = more accurate but slower.
BFMC_TSD_IMGSZ=640

# Target FPS for the traffic-sign detection thread.
# 0 = process every available frame (no rate limit, max HW speed).
# Set > 0 on constrained hardware (e.g. 5.0 for Raspberry Pi).
BFMC_TSD_FPS=0

# Which camera message to subscribe to as input for TSD.
# "mainCamera" = full-res camera frame; "serialCamera" = low-res feed.
BFMC_TSD_INPUT_MESSAGE=mainCamera

# Minimum confidence for a detected traffic sign to be forwarded to the
# position-tracking system (stop-line counter / route advancement).
# Should be ≥ BFMC_TSD_CONFIDENCE to avoid noise.
BFMC_SIGN_TRACK_CONFIDENCE=0.25

# ROI area-ratio threshold [0.0 – 1.0] for near-sign filtering.
# A detected bounding-box whose area / frame-area ≥ this value is treated
# as "near" the car and used for position tracking.  Boxes below this
# threshold are considered distant signs and ignored for localisation.
# Typical: 0.003 – 0.01.
BFMC_SIGN_ROI_MIN_RATIO=0.005

# How many route-node indices AHEAD of the current position to search
# when matching a detected sign to a sign-on-route entry.
# Larger = more tolerant but also more ambiguous; smaller = stricter.
BFMC_SIGN_MATCH_WINDOW=60

# Maximum route-node indices BEHIND the current position that are still
# considered valid for sign matching (prevents false backward jumps).
BFMC_SIGN_MATCH_BEHIND=10


# ──────────────────────────────────────────────────────────────────────────────
# NEAR-FIELD REGION OF INTEREST (ROI)
# ──────────────────────────────────────────────────────────────────────────────
# The ROI defines which part of the camera frame is sent to TSD and LA.
# Only objects within the ROI (= close to the car) are considered.
# Values are fractions of frame width/height [0.0 – 1.0].

# Vertical start of the ROI (0.0 = top edge, 1.0 = bottom edge).
# Setting 0.0 keeps only the bottom 100‰ of the frame.
BFMC_ROI_Y_START=0.0

# Vertical end of the ROI.
BFMC_ROI_Y_END=1.0

# Horizontal start (0.0 = left edge).
BFMC_ROI_X_START=0.0

# Horizontal end (1.0 = right edge).
BFMC_ROI_X_END=1.0

# Minimum stop-line distance ratio [0.0 – 1.0] for a stop-line event.
# stop_line_distance = y_avg / frame_height.  Higher value = stop line must
# be further down the frame (= closer to the car) to trigger an event.
BFMC_STOP_LINE_MIN_DISTANCE=0.5


# ──────────────────────────────────────────────────────────────────────────────
# LANE ASSIST / LANE DETECTION
# ──────────────────────────────────────────────────────────────────────────────

# Target FPS for the lane-assist perception thread.
# 0 = process every available frame (no rate limit).
BFMC_LA_FPS=0

# Which camera message to subscribe to as input for lane detection.
BFMC_LA_INPUT_MESSAGE=serialCamera

# Maximum steering angle (degrees) that the lane-keeping PID is allowed to output.
# Prevents sharp overcorrection.
BFMC_MAX_LK_STEER=25

# Optional path to a lane-detection config file (INI format) overriding individual
# lane tuning parameters.  Leave empty to use built-in defaults.
BFMC_LANE_CONFIG=


# ──────────────────────────────────────────────────────────────────────────────
# ROUTE PLANNING
# ──────────────────────────────────────────────────────────────────────────────

# Path to the GraphML file describing the competition track graph.
BFMC_GRAPHML_PATH=competition_graph.graphml

# Start node ID for the route planner.
BFMC_ROUTE_START=86
# BFMC_ROUTE_START=78

# Finish node ID for the route planner.
BFMC_ROUTE_FINISH=76

# Comma-separated list of node IDs the car must pass through (checkpoints).
BFMC_ROUTE_CHECKPOINTS=77,87,99,112,117,27,292,293,252,262,194,130,133,97
# BFMC_ROUTE_CHECKPOINTS=45,54,382,341,275,24,145,132,110,5,118,298,232,196,132,95

# When True, visit checkpoints in the exact order listed above.
# When False, the planner finds the cheapest permutation (TSP-style).
BFMC_ROUTE_VISIT_IN_ORDER=True

# Angle threshold (degrees). Turns smaller than this are classified as
# "move forward"; larger turns become "turn left" / "turn right".
BFMC_ROUTE_FORWARD_DEG=35.0

# Weight scale for the right-hand-lane heuristic (keep-right preference).
# 0.0 = no preference; higher = stronger preference for the right lane.
BFMC_ROUTE_LANE_WEIGHT_SCALE=0.35


# ──────────────────────────────────────────────────────────────────────────────
# SERIAL COMMUNICATION (STM32 / Nucleo)
# ──────────────────────────────────────────────────────────────────────────────

# Regex pattern to auto-detect the serial device (e.g. /dev/ttyACM0).
# Scanned by pyserial on startup.
BFMC_SERIAL_DEVICE_PATTERN=/dev/ttyACM\d+

# Integer ID of the V2X / traffic communication device (passed to ProcessTrafficCommunication).
BFMC_TRAFFIC_COM_DEVICE_ID=3

# Serial baud rate. Must match the firmware setting on the Nucleo board.
BFMC_SERIAL_BAUD_RATE=115200

# Serial read timeout in seconds. Controls how long pyserial waits per read.
BFMC_SERIAL_TIMEOUT=0.1

# Path to the serial communication log file (relative to Brain/).
BFMC_SERIAL_LOG_FILE=temp/serial_history.log


# ──────────────────────────────────────────────────────────────────────────────
# DASHBOARD (Flask-SocketIO)
# ──────────────────────────────────────────────────────────────────────────────

# Network interface and port the Flask-SocketIO dashboard listens on.
# "0.0.0.0" binds to all interfaces; use "127.0.0.1" for localhost only.
BFMC_DASHBOARD_HOST=0.0.0.0
BFMC_DASHBOARD_PORT=5005

# Allowed CORS origins for the WebSocket connection.
# "*" = allow all; restrict to e.g. "http://localhost:4200" in production.
BFMC_CORS_ORIGINS=*

# Dashboard-preview image size (width x height) sent over WebSocket.
# Must match BFMC_CAMERA_LORES_WIDTH x BFMC_CAMERA_LORES_HEIGHT.
BFMC_DASHBOARD_WIDTH=512
BFMC_DASHBOARD_HEIGHT=270

# Heartbeat configuration — monitors the WebSocket link to the Angular frontend.
BFMC_HEARTBEAT_MAX_RETRIES=3
BFMC_HEARTBEAT_INTERVAL=20
BFMC_HEARTBEAT_RETRY_INTERVAL=5


# ──────────────────────────────────────────────────────────────────────────────
# RECORDING
# ──────────────────────────────────────────────────────────────────────────────

# FPS for video recordings saved by the camera process.
BFMC_RECORDING_FPS=5

# FourCC codec identifier for recorded videos (e.g. XVID, MJPG, mp4v).
BFMC_RECORDING_CODEC=XVID


# ──────────────────────────────────────────────────────────────────────────────
# DEBUGGING
# ──────────────────────────────────────────────────────────────────────────────

# Enable verbose debug logging for individual processes.
# Set to True to see detailed log output in the console.
BFMC_DASHBOARD_DEBUG=False
BFMC_CAMERA_DEBUG=False
BFMC_SERIAL_DEBUG=False
BFMC_TSD_DEBUG=False
BFMC_LA_DEBUG=False
BFMC_SEMAPHORE_DEBUG=False
BFMC_TRAFFIC_COM_DEBUG=False


# ──────────────────────────────────────────────────────────────────────────────
# SYSTEM
# ──────────────────────────────────────────────────────────────────────────────

# Seconds to wait after spawning all processes before they begin execution.
# Gives time for shared resources (queues, pipes) to initialise.
BFMC_STARTUP_DELAY=10

# Timeout in seconds when joining processes during shutdown.
BFMC_SHUTDOWN_TIMEOUT=1
